{
    "default_prompt": "person",
    "default_model": "large",
    "default_refine": true,
    "default_format": "exr",
    "default_bit_depth": 16,
    
    "jobs": [
        {
            "input": "./shots/shot_001.mp4",
            "output": "./output/shot_001_roto/",
            "prompt": "person in foreground"
        },
        {
            "input": "./shots/shot_002.mp4",
            "output": "./output/shot_002_roto/",
            "prompt": "car.person",
            "sam_model": "base_plus"
        },
        {
            "input": "./shots/shot_003.mp4",
            "output": "./output/shot_003_roto/",
            "box": "100,150,800,700"
        },
        {
            "input": "./shots/shot_004/frame.####.exr",
            "output": "./output/shot_004_roto/",
            "prompt": "person",
            "refine_alpha": true,
            "output_format": "exr",
            "bit_depth": 32
        }
    ]
}
